#!/bin/sh

if [ -z "$BEAST" ]; then
	## resolve links - $0 may be a link to application
	PRG="$0"

	# need this for relative symlinks
	while [ -h "$PRG" ] ; do
	    ls=$(ls -ld "$PRG")
	    link=$(expr "$ls" : '.*-> \(.*\)$')
	    if expr "$link" : '/.*' > /dev/null; then
		PRG="$link"
	    else
		PRG="$(dirname "$PRG")/$link"
	    fi
	done

	# make it fully qualified
	saveddir=$(pwd)
	BEAST0=$(dirname "$PRG")/..
	BEAST=$(cd "$BEAST0" && pwd)
	cd "$saveddir"
fi

# Use the JRE and JARs bundled in BEAST.app by jpackage
BEAST_APP="$BEAST/BEAST.app/Contents"
export JAVA_HOME="$BEAST_APP/runtime/Contents/Home"
JAVA="$JAVA_HOME/bin/java"

# If BEAGLE_LIB is not defined, default it to Homebrew's /opt/homebrew/lib
# when BEAGLE is installed there ("brew install beagle").
# BEAGLE's macOS installer (.pkg) uses /usr/local/lib, which is added below.
# A user-defined BEAGLE_LIB always takes precedence. See #181.
# -z: true if BEAGLE_LIB is not set (empty)
if [ -z "$BEAGLE_LIB" ]; then
  if [ -d /opt/homebrew/lib ] && [ -f /opt/homebrew/lib/libhmsbeagle-jni.jnilib ]; then
    BEAGLE_LIB=/opt/homebrew/lib
  fi
fi

# use BEAGLE_LIB if the BEAGLE library is not in a standard location.
# The same on Apple silicon and Intel (#196).
# -n: true if BEAGLE_LIB is set (not empty)
if [ -n "$BEAGLE_LIB" ]; then
	if [ -n "$BEAST_EXTRA_LIBS" ]; then
		BEAST_EXTRA_LIBS="$BEAST_EXTRA_LIBS:$BEAGLE_LIB"
	else
		BEAST_EXTRA_LIBS="$BEAGLE_LIB"
	fi
fi

# Explicitly add /usr/local/lib to library search path to ensure
# beast continues to find beagle when installed here.  (This is
# necessary due to known problems with certain JREs.)
if [ -z "$LD_LIBRARY_PATH" ]; then
  export LD_LIBRARY_PATH="/usr/local/lib:$HOME/lib:$BEAST_EXTRA_LIBS"
else
  export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:/usr/local/lib:$HOME/lib:$BEAST_EXTRA_LIBS"
fi

"$JAVA" -Dlauncher.wait.for.exit=true \
    --module-path "$BEAST_APP/app" --add-modules ALL-MODULE-PATH,javafx.controls,javafx.fxml,javafx.swing,javafx.web,jdk.jsobject --enable-native-access=javafx.graphics,javafx.media,javafx.web,beagle \
    -Xss256m -Xmx8g -Djava.library.path="$LD_LIBRARY_PATH" -Duser.language=en -Dfile.encoding=UTF-8 \
    -m beast.pkgmgmt/beast.pkgmgmt.launcher.BeastLauncher "$@"
