<?xml version='1.0' encoding='UTF-8'?>
<beast version="2.8"
       namespace="beast.core:beast.core.util:beast.evolution.alignment:beast.evolution.nuc:beast.evolution.operators:beast.evolution.sitemodel:beast.evolution.substitutionmodel:beast.evolution.tree.coalescent:beast.base.core:beast.base.evolution.alignment:beast.base.evolution.likelihood:beast.base.evolution.operator:beast.base.evolution.sitemodel:beast.base.evolution.substitutionmodel:beast.base.evolution.tree:beast.base.evolution.tree.coalescent:beast.base.inference:beast.base.inference.operator:beast.base.inference.util:beast.pkgmgmt">

    <!-- Converted to BEAST 3 from beast.base/examples/legacy/testTipDates.xml.
         Proper priors (the same change is made in the BEAST 2 source):
           - hky.kappa: OneOnX (1/x) -> LogNormal(M=1, S=1.25)
           - clockRate: none (flat) -> LogNormal(M=0, S=8) in log space
         Changes made by the conversion:
           - offset="0.0" on the tip-date Uniform prior is dropped (an offset of 0 is no shift).
               If an offset is required, wrap the distribution in OffsetReal, e.g.
               <distr spec="beast.base.spec.inference.distribution.OffsetReal" offset="...">
                   <distribution spec="beast.base.spec.inference.distribution.Uniform" lower="..." upper="..."/>
               </distr>
           - SubtreeSlide is deprecated: replaced by kernel.BactrianSubtreeSlide (the gaussian flag has no equivalent), starting at its tuned size 0.73.
               BEAUti starts the slide at 0.01 (#201) and the class default is 1.0; this example keeps its tuned size, so the slide works well from the first step.
    -->


<!-- 17 taxa, 1485 sites, 138 patterns -->
<data dataType="nucleotide" id="alignment">
<sequence taxon="D4Brazi82">
            
            
        </sequence>
<sequence taxon="D4ElSal83">
            
            
        </sequence>
<sequence taxon="D4ElSal94">
            
            
        </sequence>
<sequence taxon="D4Indon76">
            
            
        </sequence>
<sequence taxon="D4Indon77">
            
            
        </sequence>
<sequence taxon="D4Mexico84">
            
            
        </sequence>
<sequence taxon="D4NewCal81">
            
            
        </sequence>
<sequence taxon="D4Philip64">
            
            
        </sequence>
<sequence taxon="D4Philip56">
            
            
        </sequence>
<sequence taxon="D4Philip84">
            
            
        </sequence>
<sequence taxon="D4PRico86">
            
            
        </sequence>
<sequence taxon="D4SLanka78">
            
            
        </sequence>
<sequence taxon="D4Tahiti79">
            
            
        </sequence>
<sequence taxon="D4Tahiti85">
            
            
        </sequence>
<sequence taxon="D4Thai63">
            
            
        </sequence>
<sequence taxon="D4Thai78">
            
            
        </sequence>
<sequence taxon="D4Thai84">
            
            
        </sequence>
</data>

    <!-- The HKY substitution model (Hasegawa, Kishino & Yano, 1985)             -->
    <input spec="beast.base.spec.evolution.substitutionmodel.HKY" id="hky">
        <parameter name="kappa" idref="hky.kappa"/>
        <input id="freqs" name="frequencies" spec="beast.base.spec.evolution.substitutionmodel.Frequencies">
            <input name="data" idref="alignment"/>
        </input>
    </input>

    <!-- site model                                                              -->
    <input spec="beast.base.spec.evolution.sitemodel.SiteModel" id="siteModel">
        <input name="substModel" idref="hky"/>
    </input>

    <parameter id="hky.kappa" value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>

    <tree spec="beast.base.spec.evolution.tree.ClusterTree" id="tree" clusterType="upgma">
		<trait spec="beast.base.evolution.tree.TraitSet" traitname="date-forward" units="year" value="    D4Brazi82  = 1982,    D4ElSal83  = 1983,    D4ElSal94  = 1994,    D4Indon76  = 1976,    D4Indon77  = 1977,    D4Mexico84 = 1984,    D4NewCal81 = 1981,    D4Philip64 = 1964,    D4Philip56 = 1956,    D4Philip84 = 1984,    D4PRico86  = 1986,    D4SLanka78 = 1978,    D4Tahiti79 = 1979,    D4Tahiti85 = 1985,    D4Thai63   = 1963,    D4Thai78   = 1978,    D4Thai84   = 1984    ">
			<taxa spec="TaxonSet" alignment="@alignment"/>
		</trait>
        <input name="taxa" idref="alignment"/>
    </tree>

    <distribution id="posterior" spec="CompoundDistribution">
        <distribution id="prior" spec="CompoundDistribution">
            <distribution id="coalescent" spec="Coalescent">
                <populationModel id="ConstantPopulation" spec="beast.base.spec.evolution.tree.coalescent.ConstantPopulation">
                    <parameter estimate="false" id="popSize" name="popSize" value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
                </populationModel>
                <treeIntervals id="TreeIntervals" spec="beast.base.evolution.tree.TreeIntervals" tree="@tree"/>
            </distribution>

            <distribution id="tipDates" monophyletic="false" spec="beast.base.spec.evolution.tree.MRCAPrior" tipsonly="true" tree="@tree">
                <taxonset id="TaxonSet0" spec="TaxonSet">
                    <taxon id="D4PRico86" spec="Taxon"/>
                </taxonset>
                <distr id="Uniform0" lower="1985" spec="beast.base.spec.inference.distribution.Uniform" upper="1987"/>
            </distribution>

            <distribution id="tipDates2" monophyletic="false" spec="beast.base.spec.evolution.tree.MRCAPrior" tipsonly="true" tree="@tree">
                <taxonset id="TaxonSet1" spec="TaxonSet">
                    <taxon id="D4ElSal94" spec="Taxon"/>
                </taxonset>
                <distr id="Noraml0" spec="beast.base.spec.inference.distribution.Normal" mean="1994" sigma="1"/>
            </distribution>

            <distribution id="kappa.prior" spec="beast.base.spec.inference.distribution.LogNormal" param="@hky.kappa" meanInRealSpace="false">
                <M spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real" value="1.0" estimate="false"/>
                <S spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="1.25" estimate="false"/>
            </distribution>
            <distribution id="clockRate.prior" spec="beast.base.spec.inference.distribution.LogNormal" param="@clockRate" meanInRealSpace="false">
                <M spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real" value="0.0" estimate="false"/>
                <S spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="8.0" estimate="false"/>
            </distribution>
        </distribution>
        <distribution id="likelihood" spec="CompoundDistribution">
			<distribution spec="beast.base.spec.evolution.likelihood.TreeLikelihood" id="treeLikelihood">
				<input name="data" idref="alignment"/>
				<input name="tree" idref="tree"/>
				<input name="siteModel" idref="siteModel"/>
                <branchRateModel id="StrictClockModel" spec="beast.base.spec.evolution.branchratemodel.StrictClockModel">
                    <parameter estimate="true" id="clockRate" name="clock.rate" value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
                </branchRateModel>
		    </distribution>
		</distribution>
	</distribution>

    <run spec="MCMC" id="mcmc" chainLength="1000000">
        <state>
            <input name="stateNode" idref="hky.kappa"/>
            <input name="stateNode" idref="clockRate"/>
            <input name="stateNode" idref="tree"/>
        </state>

        <distribution idref="posterior"/>

	    <operator id="TipDatesRandomWalker" windowSize="1" spec="TipDatesRandomWalker" taxonset="@TaxonSet0" tree="@tree" weight="1.0"/>
	    <operator id="TipDatesRandomWalker2" windowSize="1" spec="TipDatesRandomWalker" taxonset="@TaxonSet1" tree="@tree" weight="1.0"/>

        <operator id="kappaScaler" scaleFactor="0.5" weight="1" parameter="@hky.kappa" spec="beast.base.spec.inference.operator.ScaleOperator"/>
        <operator id="clockRateScaler" scaleFactor="0.5" weight="1" parameter="@clockRate" spec="beast.base.spec.inference.operator.ScaleOperator"/>

        <operator id="treeScaler" scaleFactor="0.5" weight="1" tree="@tree" spec="beast.base.spec.evolution.operator.ScaleTreeOperator"/>
        <operator spec="beast.base.evolution.operator.Uniform" weight="10" tree="@tree"/>
        <operator spec="beast.base.evolution.operator.kernel.BactrianSubtreeSlide" weight="5" size="0.73" tree="@tree"/>
        <operator id="narrow" spec="Exchange" isNarrow="true" weight="1" tree="@tree"/>
        <operator id="wide" spec="Exchange" isNarrow="false" weight="1" tree="@tree"/>
        <operator spec="WilsonBalding" weight="1" tree="@tree"/>

        <logger logEvery="1000" fileName="test.$(seed).log">
            <log idref="likelihood"/>
			<log idref="tipDates"/>
			<log idref="tipDates2"/>
			<log idref="hky.kappa"/>
			<log idref="clockRate"/>
            <log spec="beast.base.evolution.tree.TreeStatLogger" tree="@tree"/>
        </logger>
        <logger logEvery="10000" fileName="test.$(seed).trees">
            <log idref="tree"/>
        </logger>
        <logger logEvery="10000">
            <log idref="likelihood"/>
        </logger>

    </run>
</beast>
