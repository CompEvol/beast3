    <input spec="beast.base.spec.evolution.branchratemodel.RandomLocalClockModel" id="branchRates" ratesAreMultipliers="false" tree="@tree">
        <!--<parameter name='mutationRate'>1.0</parameter>-->
        <parameter name="rates" id="rates" value="1" spec="beast.base.spec.inference.parameter.RealVectorParam" domain="PositiveReal"/>
        <indicators id="indicators" value="false" spec="beast.base.spec.inference.parameter.BoolVectorParam"/>
    </input>

    <input spec="beast.base.spec.evolution.likelihood.TreeLikelihood" id="treeLikelihood" data="@alignment" tree="@tree" branchRateModel="@branchRates">
        <siteModel spec="beast.base.spec.evolution.sitemodel.SiteModel" id="siteModel">
            <!-- The HKY substitution model (Hasegawa, Kishino & Yano, 1985)             -->
            <substModel spec="beast.base.spec.evolution.substitutionmodel.HKY" id="hky">
                <parameter name="kappa" idref="hky.kappa"/>
                <frequencies id="freqs" spec="beast.base.spec.evolution.substitutionmodel.Frequencies" data="@alignment"/>
            </substModel>
        </siteModel>
    </input>

    <tree spec="beast.base.spec.evolution.tree.ClusterTree" id="tree" clusterType="upgma" taxa="@alignment"/>

    <parameter id="hky.kappa" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal">1.0</parameter>

    <parameter id="popSize" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal">1.0</parameter>

    <run spec="MCMC" id="mcmc" chainLength="2000000"> <!--autoOptimize="true"-->
        <state>
            <input name="stateNode" idref="hky.kappa"/>
            <input name="stateNode" idref="popSize"/>
            <input name="stateNode" idref="rates"/>
            <input name="stateNode" idref="tree"/>
            <input name="stateNode" idref="indicators"/>
        </state>

        <distribution spec="CompoundDistribution" id="posterior">
            <distribution id="hky.kappa.prior" spec="beast.base.spec.inference.distribution.LogNormal" param="@hky.kappa" meanInRealSpace="false">
                <M spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real" value="1.0" estimate="false"/>
                <S spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="1.25" estimate="false"/>
            </distribution>
            <distribution id="popSize.prior" spec="beast.base.spec.inference.distribution.LogNormal" param="@popSize" meanInRealSpace="false">
                <M spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real" value="0.0" estimate="false"/>
                <S spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="8.0" estimate="false"/>
            </distribution>
            <distribution id="rates.prior" spec="beast.base.spec.inference.distribution.IID" param="@rates">
                <distr id="rates.prior.distr" spec="beast.base.spec.inference.distribution.LogNormal" meanInRealSpace="false">
                    <M spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real" value="0.0" estimate="false"/>
                    <S spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="8.0" estimate="false"/>
                </distr>
            </distribution>
            <distribution id="coalescent" spec="Coalescent">
                <treeIntervals spec="beast.base.evolution.tree.TreeIntervals" id="TreeIntervals">
                     <tree idref="tree"/>
                </treeIntervals>
                <populationModel spec="beast.base.spec.evolution.tree.coalescent.ConstantPopulation">
                    <parameter name="popSize" idref="popSize"/>
                </populationModel>
            </distribution>
            <distribution id="likelihood" idref="treeLikelihood"/>
        </distribution>

        <!--operator id="indicatorsRandomWalk" spec="UniformOperator" weight="1" parameter='@indicators'/-->
        <operator id="indicatorFlip" spec="beast.base.spec.inference.operator.BitFlipOperator" weight="1" parameter="@indicators"/>
        <operator id="rateScaler" scaleFactor="0.5" weight="1" parameter="@rates" spec="beast.base.spec.inference.operator.ScaleOperator"/>

        <operator id="kappaScaler" scaleFactor="0.5" weight="1" parameter="@hky.kappa" spec="beast.base.spec.inference.operator.ScaleOperator"/>
        <operator id="popSizeScaler" scaleFactor="0.5" weight="1" parameter="@popSize" spec="beast.base.spec.inference.operator.ScaleOperator"/>

        <operator id="treeScaler" scaleFactor="0.5" weight="1" tree="@tree" spec="beast.base.spec.evolution.operator.ScaleTreeOperator"/>
        <operator weight="10" tree="@tree" spec="beast.base.evolution.operator.Uniform"/>
        <operator spec="beast.base.evolution.operator.kernel.BactrianSubtreeScale" weight="5" tree="@tree"/>
        <operator id="narrow" spec="Exchange" isNarrow="true" weight="1" tree="@tree"/>
        <operator id="wide" spec="Exchange" isNarrow="false" weight="1" tree="@tree"/>
        <operator spec="WilsonBalding" weight="1" tree="@tree"/>

        <logger logEvery="10000" fileName="test.$(seed).log">
	    <model idref="posterior"/>
            <log idref="coalescent"/>
            <log idref="likelihood"/>
            <log spec="beast.base.evolution.tree.TreeStatLogger">
                <tree idref="tree"/>
            </log>
            <log idref="popSize"/>
            <log idref="hky.kappa"/>
            <log idref="indicators"/>
            <log idref="rates"/>
            <log idref="posterior"/>
        </logger>
        <logger logEvery="10000" fileName="test.$(seed).trees">
            <log idref="tree"/>
        </logger>
        <logger logEvery="10000">
	    <model idref="posterior"/>
            <log idref="coalescent"/>
            <log idref="likelihood"/>
            <log spec="beast.base.evolution.tree.TreeStatLogger">
                <tree idref="tree"/>
            </log>
            <log idref="popSize"/>
            <log idref="hky.kappa"/>
            <log idref="indicators"/>
            <log idref="posterior"/>
        </logger>
    </run>

</beast>
