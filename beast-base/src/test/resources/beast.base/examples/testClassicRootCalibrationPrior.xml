<?xml version="1.0" standalone="yes"?>
<beast version="2.8"
       namespace="beast.base.spec.inference.parameter:beast.base.spec.inference.operator:beast.base.spec.inference.distribution:beast.base.spec.evolution.speciation:beast.base.spec.evolution.tree:beast.base.spec.evolution.operator:beast.base.spec.domain:beast.base.evolution.alignment:beast.base.evolution.tree:beast.pkgmgmt:beast.base.core:beast.base.inference:beast.base.inference.operator:beast.base.evolution.operator">

    <!-- for Figure 9.1 in BEAST2 book. BEAST 3 conversion of the BEAST 2.7.8 example
         testClassicRootCalibrationPrior.xml.
         The 2.7.8 original puts an improper OneOnX (1/x) prior on the birth rate. Both the BEAST 2 example and this conversion now use a proper LogNormal(0, 8) prior (M = 0 in log space, median 1, 95% from 1.6e-7 to 6.4e6). -->

    <taxonset spec="TaxonSet" id="taxa">
        <taxon spec="Taxon" id="1"/>
        <taxon spec="Taxon" id="2"/>
        <taxon spec="Taxon" id="3"/>
        <taxon spec="Taxon" id="4"/>
    </taxonset>

    <data id="alignment" dataType="nucleotide">
        <sequence taxon="1">A</sequence>
        <sequence taxon="2">A</sequence>
        <sequence taxon="3">A</sequence>
        <sequence taxon="4">A</sequence>
    </data>

    <input spec="YuleModel" id="yule">
        <birthDiffRate id="birthRate" spec="RealScalarParam" domain="PositiveReal" value="1.0"/>
        <tree spec="TreeParser" id="tree" taxa="@alignment" newick="(((1:1.0,2:1.0):1.0,3:2.0):1.0,4:3.0);"/>
    </input>

    <distribution id="rootPrior" spec="MRCAPrior" tree="@tree" monophyletic="true">
            <taxonset spec="TaxonSet" id="all">
                <taxon idref="1"/>
                <taxon idref="2"/>
                <taxon idref="3"/>
                <taxon idref="4"/>
            </taxonset>
        <distr id="logNormalDistribution" spec="LogNormal">
                <M spec="RealScalarParam" domain="Real" value="2.0" estimate="false"/>
                <S spec="RealScalarParam" domain="PositiveReal" value="0.2" estimate="false"/>
        </distr>
    </distribution>

    <run spec="MCMC" id="mcmc" chainLength="1000000">

        <state>
            <stateNode idref="tree"/>
            <stateNode idref="birthRate"/>
        </state>

        <distribution spec="CompoundDistribution" id="posterior">
            <distribution id="yule.prior" idref="yule"/>
            <distribution idref="rootPrior"/>

            <distribution id="birthRate.prior" spec="LogNormal" param="@birthRate" meanInRealSpace="false">
                <M spec="RealScalarParam" domain="Real" value="0.0" estimate="false"/>
                <S spec="RealScalarParam" domain="PositiveReal" value="8.0" estimate="false"/>
            </distribution>
        </distribution>

        <operator spec="beast.base.evolution.operator.kernel.BactrianSubtreeSlide" weight="4" size="4.1" tree="@tree"/>
        <operator spec="ScaleOperator" weight="1" scaleFactor="0.25" parameter="@birthRate"/>

        <logger logEvery="100" fileName="classic_root_prior_oneOnX.$(seed).log">
            <model idref="posterior"/>
            <log idref="posterior"/>
            <log idref="yule"/>
            <log spec="MRCAPrior" tree="@tree" id="all.age" taxonset="@all"/>
            <log idref="birthRate"/>
        </logger>
        <logger logEvery="100" fileName="classic_root_prior_oneOnX.$(seed).trees">
            <log idref="tree"/>
        </logger>
        <logger logEvery="100">
            <model idref="posterior"/>
            <log idref="yule"/>
            <log idref="birthRate"/>
        </logger>
    </run>
</beast>
